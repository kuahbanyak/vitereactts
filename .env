# Local development - direct API connection (CORS handled by browser/backend)
VITE_API_BASE_URL=http://localhost:8080
# For production, use .env.production with empty VITE_API_BASE_URL to use Netlify proxy

# Role Names Configuration
VITE_ADMIN_ROLE=admin
VITE_MANAGER_ROLE=manager
VITE_MECHANIC_ROLE=mechanic
VITE_CUSTOMER_ROLE=customer
